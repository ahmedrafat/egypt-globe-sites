{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "redirects": [
    { "source": "/products/salt/de-icing-salt/:rest*",        "destination": "/products/salt", "permanent": true },
    { "source": "/products/salt/industrial-salt",             "destination": "/products/salt", "permanent": true },
    { "source": "/products/salt/sea-salt",                    "destination": "/products/salt", "permanent": true },
    { "source": "/products/salt/tablet-salt/:rest*",          "destination": "/products/salt", "permanent": true },
    { "source": "/products/salt/vacuum-tablet/:rest*",        "destination": "/products/salt", "permanent": true },
    { "source": "/salt/pharmaceutical-salt",                  "destination": "/products/salt", "permanent": true },
    { "source": "/salt/:rest*",                               "destination": "/products/salt", "permanent": true },
    { "source": "/sl-:rest*",                                 "destination": "/products/salt", "permanent": true },

    { "source": "/products/construction/cement-clinker",         "destination": "/products/construction/cement-and-clinker", "permanent": true },
    { "source": "/products/construction/cement-clinker/:rest*",  "destination": "/products/construction/cement-and-clinker", "permanent": true },
    { "source": "/products/construction/gypsum-plaster",         "destination": "/products/construction/gypsum",             "permanent": true },

    { "source": "/products/fertilizers/phosphates",        "destination": "/products/fertilizers/phosphate", "permanent": true },
    { "source": "/products/fertilizers/phosphates/:rest*", "destination": "/products/fertilizers/phosphate", "permanent": true },
    { "source": "/products/fertilizers/potassium",         "destination": "/products/fertilizers/potash", "permanent": true },
    { "source": "/products/fertilizers/potassium/:rest*",  "destination": "/products/fertilizers/potash", "permanent": true },

    { "source": "/products/chemicals/acids",                "destination": "/products/chemicals/solvents-and-acids", "permanent": true },
    { "source": "/products/chemicals/acids/:rest*",         "destination": "/products/chemicals/solvents-and-acids", "permanent": true },
    { "source": "/products/chemicals/alkalis-salts",        "destination": "/products/chemicals/industrial-chemicals", "permanent": true },
    { "source": "/products/chemicals/alkalis-salts/:rest*", "destination": "/products/chemicals/industrial-chemicals", "permanent": true },

    { "source": "/products/edible-oils",                    "destination": "/products/agro/edible-oils", "permanent": true },
    { "source": "/products/edible-oils/:rest*",             "destination": "/products/agro/edible-oils", "permanent": true },

    { "source": "/products/minerals/gypsum-and-plaster",    "destination": "/products/construction/gypsum", "permanent": true }
  ]
}
